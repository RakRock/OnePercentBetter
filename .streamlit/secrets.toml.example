# Copy to secrets.toml and fill in your values (secrets.toml is gitignored).

# Edgenuity practice report emails
PRACTICE_REPORT_EMAIL_TO = "your-email@example.com"
PRACTICE_REPORT_EMAIL_ENABLED = true

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your-email@example.com"
SMTP_PASSWORD = "your-app-password"
SMTP_FROM = "your-email@example.com"
SMTP_USE_TLS = true

# Optional — used by other modules in this app
# XAI_API_KEY = ""
# ANTHROPIC_API_KEY = ""
# HF_TOKEN = ""
